# Neither variable is required to run locally - both have working defaults.
# Copy this file to .env if you use one, or just export these directly; the app does
# not load .env automatically (no python-dotenv dependency - see README.md >
# Configuration).

# Base URL of the resident history API. Local default: http://127.0.0.1:8083
# In deployment (see render.yaml), this is set automatically via Render's fromService
# linking to a bare "host:port" - history_client.py adds the http:// prefix itself.
HISTORY_SERVICE_URL=http://127.0.0.1:8083

# Optional: enables LLM-phrased triage note text instead of the deterministic
# template. Never required - see DECISIONS.md > "LLM Usage". Do not commit a real key.
ANTHROPIC_API_KEY=
